# /etc/newstron/newstron.env: root:newstron 0640 (docs/LAYOUT.md). Every newstron unit and
# pip-audit-scan load it with EnvironmentFile=, so it is the only place a secret lives.

# The bearer token for the memory server's /news/* routes: the same value as NEWSTRON_SECRET in the
# memory server's env file. It opens only the news API, never the MCP endpoint.
NEWSTRON_SECRET=

# Base URL of the memory server. No secret in it: the token above goes in a header.
MEMORY_URL=http://127.0.0.1:8765

# Optional overrides; the values shown are the defaults.
# NEWSTRON_FEEDS_FILE=/etc/newstron/feeds.yaml
# NEWSTRON_STATE_DIR=/var/lib/newstron
# NEWSTRON_LOG_DIR=/var/log/newstron
# The memory server head whose "yes" pulls items from tiers 2-9 into the digest's security section.
# Without a trained head of that name nothing is pulled; empty turns the lookup off.
# NEWSTRON_DIGEST_HEAD=security
# The venvs pip-audit-scan audits (spaces or colons).
# SHIELD_VENVS=/opt/memory/venv /opt/newstron/venv
