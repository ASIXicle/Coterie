# newstron-fetch.service — fetch the feeds into the memory server's news collection (docs/LAYOUT.md Units table).
[Unit]
Description=newstron: fetch the feeds into the memory server's news collection
After=network-online.target memory.service
Wants=network-online.target

[Service]
Type=oneshot
User=newstron
Group=newstron
EnvironmentFile=/etc/newstron/newstron.env
ExecStart=/opt/newstron/venv/bin/python3 /opt/newstron/fetcher.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/newstron /var/log/newstron
