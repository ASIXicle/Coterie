# newstron-security.service — hourly security-tier fetch (docs/LAYOUT.md Units table).
[Unit]
Description=newstron: hourly security-tier fetch
After=network-online.target memory.service
Wants=network-online.target

[Service]
Type=oneshot
User=newstron
Group=newstron
EnvironmentFile=/etc/newstron/newstron.env
ExecStart=/opt/newstron/venv/bin/python3 /opt/newstron/fetcher.py --tier 1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/newstron /var/log/newstron
