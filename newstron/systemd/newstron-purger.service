# newstron-purger.service — per-tier purge of the news collection (docs/LAYOUT.md Units table).
[Unit]
Description=newstron: per-tier purge of the news collection
After=network-online.target memory.service
Wants=network-online.target

[Service]
Type=oneshot
User=newstron
Group=newstron
EnvironmentFile=/etc/newstron/newstron.env
ExecStart=/opt/newstron/venv/bin/python3 /opt/newstron/purger.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/newstron /var/log/newstron
