# site.env -- host facts for ONE deployment of the portal. Copy to site.env
# (gitignored) beside this file and fill in. Scripts read ${SITE_ENV:-install/site.env}.
#
# Everything about the panes themselves -- names, ports, colours, the orchestrator --
# lives in the roster (config/agents.json) and is never repeated here. This file holds only what
# is about the host: where the deployed copy lives, what address Caddy serves, how
# TLS is done, who may connect, and where the agents' mail queue is.

# Deployed copy (Caddy's webroot is $PORTAL_ROOT/portal, chorusd runs from
# $PORTAL_ROOT/chorus). Default when empty: /srv/portal (set it if your site serves from elsewhere; never under a home),
# orchestrator taken from the roster at run time.
PORTAL_ROOT=

# REQUIRED. The LAN address Caddy serves https:// on. Used for the site block,
# the post-install probes and the ssh hint in each pane's autostart block.
LAN_IP="<LAN_IP>"

# Optional. A hostname served alongside LAN_IP (same site block, same cert).
SITE_NAME=

# internal = Caddy's own CA, nothing leaves the LAN, import caddy-root.crt once.
# auto     = Caddy's public ACME issuance (needs a public name in SITE_NAME).
TLS_MODE=internal

# Who may reach the portal (and the git server on 3000): Caddy's `private_ranges` (the private IPv4
# and IPv6 ranges and loopback; setup's default), or space-separated client addresses or ranges.
# Every other client is aborted (dropped, no response). Empty = ANY client that can reach the ports,
# which is not what you want on a network you share. The portal's password applies either way.
CADDY_ALLOWLIST="private_ranges"

# Optional, both or neither, and normally EMPTY: chorusd then polls the layout's
# mail root (/var/lib/memory-amq) directly. Set both only for a mail root under
# another user's private home, which chorusd must list through that user.
AMQ_ROOT=
AMQ_USER=

# Optional overrides of docs/LAYOUT.md defaults, for a host laid out differently. Leave empty
# on a fresh install. COTERIE_AGENTS_JSON also tells the install scripts where the roster is.
CHORUSD_PORT=
CHORUSD_CODE=
CHORUSD_STATE_DIR=
COTERIE_AGENTS_JSON=
STOP_HOOK_NAME=

# Optional. Where each pane's shell and Claude Code start. Empty = the agent's home (~). Claude Code
# keeps an agent's project memory per directory, so change it only before the agents' first boot.
PANE_WORKDIR=

# Optional. The group the web server runs in (Caddy's: caddy). Each pane's socket directory belongs
# to it, so only the agent and the web server can reach the pane. Empty = caddy.
PANE_PROXY_GROUP=
